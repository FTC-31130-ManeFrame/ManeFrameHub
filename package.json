{
  "name": "first-robotics-project-hub-(frc-ph)",
  "private": true,
  "version": "0.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx server/index.ts\" \"vite\" \"tailwindcss -i ./index.css -o ./public/tailwind.css --watch\"",
    "server": "tsx server/index.ts",
    "client": "vite",
    "build:css": "tailwindcss -i ./index.css -o ./public/tailwind.css --minify",
    "build": "npm run build:css && vite build",
    "preview": "vite preview",
    "start": "TZ=UTC NODE_ENV=production tsx server/index.ts",
    "db:push": "echo 'No-op by design: schema is applied at boot by server/index.ts. For a deliberate push run: npm run schema:push  (see replit.md)'",
    "schema:push": "drizzle-kit push --config=db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=db/drizzle.config.ts",
    "db:reset": "tsx server/reset.ts",
    "db:diagnose-tz": "tsx server/diagnoseTimestamps.ts",
    "db:migrate-timestamptz": "tsx server/migrateTimestamptz.ts"
  },
  "dependencies": {
    "@touch4it/ical-timezones": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pako": "^2.0.4",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "autoprefixer": "^10.6.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "concurrently": "^10.0.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "html5-qrcode": "^2.3.8",
    "ical-generator": "^11.1.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.562.0",
    "pako": "^2.2.0",
    "pg": "^8.23.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.28",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "rrule": "^2.8.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.13",
    "web-push": "^3.6.7",
    "zod": "^4.6.2"
  },
  "overrides": {
    "protobufjs": "^7.6.5",
