    "brace-expansion": "^5.0.8",
    "shell-quote": "^1.10.0",
    "minimatch": "^9.0.9",
    "path-to-regexp": "^8.4.2",
    "websocket-driver": "^0.7.5",
    "@types/express-serve-static-core": "5.1.0",
    "fdir": {
      "picomatch": "^4.0.5"
    },
    "tinyglobby": {
      "picomatch": "^4.0.5"
    },
    "chokidar": {
      "picomatch": "^2.3.2"
    },
    "micromatch": {
